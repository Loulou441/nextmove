# Copier ce fichier en ".env" et renseigner les valeurs (le ".env" réel n'est jamais versionné).

# --- Secrets ---
GROQ_API_KEY=

# --- Modèles Groq (un modèle par sport, optionnel) ---
MODEL_NAME_PICKELBALL=openai/gpt-oss-20b
MODEL_NAME_TENNIS=openai/gpt-oss-20b
MODEL_NAME_PADEL=openai/gpt-oss-20b

# Température des complétions (0.0 = réponses déterministes)
GROQ_TEMPERATURE=0.0

# --- Personnalisation de l'app / white-label ---
APP_PAGE_TITLE=NextMove
APP_PAGE_ICON=🏓
DEFAULT_SPORT=pickleball

# --- Configuration native Streamlit (optionnelle, préfixe STREAMLIT_) ---
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_MAX_UPLOAD_SIZE=500

# --- Vision par ordinateur (optionnel) ---
# Dossier des poids YOLO (.pt), par défaut training/models/exported/ à la racine du dépôt
# CV_WEIGHTS_DIR=


# --- Base de données (Supabase) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# mdp hashé
SECRET_KEY=