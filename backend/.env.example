# Copier dans backend/.env ; ne pas versionner les vraies valeurs.
# Réutiliser DATABASE_URL et SECRET_KEY existantes pour conserver comptes/tokens.
DATABASE_URL=postgresql://user:password@localhost:5432/nextmove
SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GROQ_API_KEY=
# Par défaut : training/models/exported/ à la racine du dépôt.
# CV_WEIGHTS_DIR=/chemin/absolu/vers/les/modeles

# Origines web autorisées, séparées par des virgules (pas de *).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local HTTP : false/lax. Production HTTPS : true/lax (même site),
# ou true/none si frontend et API sont sur des sites différents.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Facultatif, uniquement si les embeddings sont déjà en cache :
# HF_HUB_OFFLINE=1
