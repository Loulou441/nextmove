# Copier dans backend/.env ; ne pas versionner les vraies valeurs.
# Réutiliser DATABASE_URL et SECRET_KEY existantes pour conserver comptes/tokens.
DATABASE_URL=postgresql://user:password@localhost:5432/nextmove
SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GROQ_API_KEY=
# Par défaut : training/models/exported/ à la racine du dépôt.
# CV_WEIGHTS_DIR=/chemin/absolu/vers/les/modeles
