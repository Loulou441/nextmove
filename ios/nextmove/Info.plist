<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Exception App Transport Security (ATS) : autorise le HTTP en clair vers
	  localhost, nécessaire pour parler à l'API FastAPI lancée sur la machine de
	  dev (http://localhost:8000) depuis le simulateur.
	  À RETIRER en production : le backend déployé sera en HTTPS.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Autorise le HTTP en clair vers localhost / *.local (simulateur). -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!--
		  Exception explicite pour l'IP LAN du Mac de dev : nécessaire pour qu'un
		  iPhone PHYSIQUE puisse joindre http://192.168.1.175:8000 en clair.
		  Si l'IP du Mac change, mets à jour la clé de domaine ci-dessous.
		  À RETIRER en production (backend en HTTPS).
		-->
		<key>NSExceptionDomains</key>
		<dict>
			<key>192.168.1.175</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
