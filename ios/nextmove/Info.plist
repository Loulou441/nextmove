<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  URL de base de l'API FastAPI.
	  • Simulateur  : laisser vide — NextMoveAPI utilise http://localhost:8000 par défaut.
	  • iPhone physique sur le réseau local : mettre l'IP LAN du Mac, ex. http://192.168.1.175:8000
	  • Production : mettre l'URL HTTPS du serveur déployé.
	  Modifier cette valeur ne nécessite pas de recompiler, il suffit de rebuilder (⌘B).
	-->
	<key>NEXTMOVE_API_URL</key>
	<string>http://192.168.1.175:8000</string>

	<!--
	  App Transport Security.
	  • NSAllowsLocalNetworking : autorise HTTP vers localhost et *.local (simulateur).
	  • NSExceptionDomains : exception HTTP en clair pour les IPs LAN en développement.
	    À supprimer en production (le backend déployé sera en HTTPS).
	  Si l'IP du Mac change, mettre à jour NEXTMOVE_API_URL ci-dessus ET la clé
	  de domaine ci-dessous.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>192.168.1.175</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
