    "Positioning Too Deep" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positionnement trop en retrait"
          }
        }
      }
    },
    "Practice dinking while maintaining position at the kitchen line. Focus on staying close to the line without stepping into the kitchen." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travaille tes dinks en restant positionné sur la ligne de la cuisine. Reste proche de la ligne sans entrer dans la cuisine."
          }
        }
      }
    },
    "Practice moving to different court positions without a ball. Focus on quick, efficient movements and maintaining balance." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entraîne-toi à te déplacer vers différentes positions du court sans balle. Vise des déplacements rapides et efficaces tout en gardant l’équilibre."
          }
        }
      }
    },
    "Practice moving to your weaker side" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entraîne-toi à te déplacer vers ton côté faible"
          }
        }
      }
    },
    "Practice shots on your weaker side against a wall. Focus on early contact point and smooth weight transfer through the shot." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travaille tes coups du côté faible contre un mur. Vise un point de contact tôt et un transfert du poids fluide sur le coup."
          }
        }
      }
    },
    "Practice split-step timing and quick reactions" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travaille le timing du split-step et les réactions rapides"
          }
        }
      }
    },
    "Practice the split-step timing: small hop as your opponent contacts the ball. This prepares you to move quickly in any direction." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travaille le timing du split-step : un petit saut au moment où ton adversaire touche la balle. Ça te prépare à partir vite dans toutes les directions."
          }
        }
      }
    },
    "Practice the third-shot drop: arc it into the kitchen so you can move forward safely." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travaille le drop de 3e frappe : donne-lui une trajectoire courbe dans la cuisine pour pouvoir avancer en sécurité."
          }
        }
      }
    },
    "Prepare earlier on your weaker side" : {
