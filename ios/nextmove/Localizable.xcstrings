    "Player Profile" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil du joueur"
          }
        }
      }
    },
    "Player selection groups detections by court position. It works within a clip; a player who leaves and re-enters after a long gap may not re-link (appearance-based re-identification is a planned improvement)." : {
      "comment" : "A note about the limitations of player selection.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sélection du joueur regroupe les détections par position sur le terrain. Elle fonctionne au sein d'une vidéo ; un joueur qui sort puis revient après une longue absence peut ne pas être ré-associé (la ré-identification par apparence est une amélioration prévue)."
          }
        }
      }
    },
    "Players" : {
      "comment" : "A title for a view that shows a list of players.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
