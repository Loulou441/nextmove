<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Exception App Transport Security (ATS) : autorise le HTTP en clair vers
	  localhost, nécessaire pour parler à l'API FastAPI lancée sur la machine de
	  dev (http://localhost:8000) depuis le simulateur.
	  À RETIRER en production : le backend déployé sera en HTTPS.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
